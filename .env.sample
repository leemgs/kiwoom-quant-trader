# 한국투자증권 (KIS) API 인증 정보
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_SUFFIX=01
KIS_VIRTUAL_TRADING=true
INVESTMENT_BUDGET=10000
INVESTMENT_PERIOD_MONTH=1
INVESTMENT_INCOME_GOAL=100000

# 알림 및 부가 기능 연동 (선택)
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL_ID=your_slack_channel_id_here
GEMINI_API_KEY=your_gemini_api_key_here

# Trading configuration (comma‑separated values)
UNIVERSE=005930,000660,035420,035720
US_UNIVERSE=AAPL.US,MSFT.US,GOOGL.US
MAX_TRADING_LIMIT=10000
K_VALUE=0.4
STOP_LOSS=0.015
TAKE_PROFIT=0.05
MAX_STOCKS=1
EXTREME_GROWTH_ENABLE=true
EXTREME_GROWTH_USE_MARGIN=true
EXTREME_GROWTH_SMART_ORDER=true
EXTREME_GROWTH_MICRO_SCALPING=3
EXTREME_GROWTH_LIMIT_UP=true
EXTREME_GROWTH_KELLY=true
# Smart Momentum Strategy (스마트 모멘텀 전략)
EXTREME_GROWTH_BREAKOUT_THRESHOLD=0.015  # 시가 대비 진입 임계값 (1.5%)
EXTREME_GROWTH_MOMENTUM_TICKS=3          # 연속 상승 확인 틱 수
EXTREME_GROWTH_TRAILING_STOP=0.015       # 고점 대비 트레일링 스탑 비율 (1.5%)
EXTREME_GROWTH_BUY_START_TIME=09:15:00   # 신규 매수 진입 시작 시간 (장초반 9시~9시15분 사이의 가짜 돌파/고변동성 손실 차단용)
EXTREME_GROWTH_MAX_BREAKOUT_THRESHOLD=0.07 # 진입 조건: 시가 대비 최대 상승 제한값 (추격 매수 및 상단 꼭대기 물림 방지, 기본 7.0%)
EXTREME_GROWTH_TRAILING_ACTIVATION=0.02  # 트레일링 스탑 활성화 임계값 (예: 0.02 = 2.0% 도달 시 트레일링 스탑 가동)

# Market Regime Filter (시장 하락장 감지 — 하락장에는 신규 매수 중단)
MARKET_REGIME_FILTER_ENABLE=true         # 하락장 필터 사용 여부 (true 시 시장 하락 추세일 때 신규 매수 중단)
MARKET_REGIME_INDICES=^KS11,^KQ11        # 감시할 시장 대표 지수 (기본: 코스피, 코스닥 / yfinance 심볼, 쉼표 구분)
MARKET_REGIME_MA_WINDOW=20               # 추세 판정용 이동평균 기간(일). 현재가가 이평선 아래면 하락 추세로 간주
MARKET_REGIME_CRASH_THRESHOLD=0.015      # 당일 급락 임계값 (0.015 = 지수 -1.5% 이하 급락 시 하락 판정)
MARKET_REGIME_CACHE_TTL=300              # 하락장 판정 결과 캐시 시간(초). yfinance 호출 부하 완화
MARKET_REGIME_AGGREGATION=any            # 다중 지수 종합 방식 (any: 하나라도 하락이면 중단 / all: 모두 하락일 때만 중단)

